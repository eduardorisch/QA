  <folder name="Technology &amp; Physical" id="id-b9e87529e3b646c5a669afc1d81069ba" type="technology"/>
  <folder name="Motivation" id="id-01dca29a54d94e5daaa31cf522f74cab" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Dono da Software house" id="id-c50cb038301545b4b0270e714f8a16d0"/>
    <element xsi:type="archimate:Driver" name="Formalização e controle administrativo sobre atividades de suporte" id="id-fd59b5cae77f4fb4bb7a0abd8a5ba905"/>
    <element xsi:type="archimate:Principle" name="Fazer registro formal de chamados tecnicos" id="id-ea7a2b639b4d456180a459eb4afd8300"/>
    <element xsi:type="archimate:Principle" name="Controlar tempo de atendimento de cada chamado" id="id-7d14d1705c58478f9f569bb0f6b04125"/>
    <element xsi:type="archimate:Principle" name="Medição de satisfação so clientes" id="id-ea7118750d01414cadc74b824d23d319"/>
    <element xsi:type="archimate:Goal" name="Workflow do fluxo de atendimentos de chamados" id="id-ef41f69f53d1416b9caab8378d7f4e91"/>
    <element xsi:type="archimate:Goal" name="Comunicação com o cliente e demandante para feedbacks" id="id-637ea70798524b76acf4569a6f754167"/>
    <element xsi:type="archimate:Goal" name="Gerar consultas, relatorios, dashboards de acompanhamento de desempenho do suporte" id="id-2b20b1c45e4942a799e61b992e97d739"/>
    <element xsi:type="archimate:Assessment" name="Workflow digitalizado com apoio da IA em cada processo" id="id-9f423ecdcc184d619d2976c9cee6af07"/>
    <element xsi:type="archimate:Assessment" name="Usar um sistema de comunicação instatanea digital e público" id="id-f467604a211f4ae492d2e7d657db49db"/>
    <element xsi:type="archimate:Assessment" name="Usar solução de BI de mercado" id="id-d3bd54cc32414ed59f2449206e719c4c"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-24cc10dcf20f458594adf86eca8f649c"/>
    <element xsi:type="archimate:Outcome" name="100% dos atendimentos de suporte registrados no sistema de informação disponibilizado" id="id-92f3be7b00334781afdff1fc687eeec2"/>
    <element xsi:type="archimate:Outcome" name="Aumentar o nivel de satisfação dos clientes de forma gradual, a partir da implantação da solução" id="id-49c7310ad7a94ae681c439daedcd32c9"/>
    <element xsi:type="archimate:Requirement" name="Registrar novo chamado" id="id-69525e7af8f442fab8dde59b007dba5a"/>
    <element xsi:type="archimate:Requirement" name="Triagem de chamados para encaminhamento" id="id-e67ec23d67cc446787a4dc8c9ce9fc1a"/>
    <element xsi:type="archimate:Requirement" name="Registrar log de ação realizada no atendimento" id="id-167f681816154e509e5327c0134bbb24"/>
    <element xsi:type="archimate:Requirement" name="Registrar solução para problema" id="id-1b939fa753fc4f4f939022516736ce7e"/>
    <element xsi:type="archimate:Constraint" name="Deve ser informado pelo usuario a identificação do cliente, a descrição do problema. O sistema deve gerar um numero de protocolo de registro de chamada, com a data e hora de abertura e a identificação do analista de suporte que fez o contato, atribuind o status pendente. Somente clientes com contrato de suporte terão registro de chamado" id="id-c7201748ba4a483b92eed431aa9392ba"/>
    <element xsi:type="archimate:Constraint" name="Um analista de suporte de 1ºnivel deve avaliar os chamados que estão pendentes e não tem equipe tecnica associada para solução e apontar uma equipe tecnica atualizando os dados do chamado" id="id-33b0820d891240278f549d731f08991d"/>
    <element xsi:type="archimate:Constraint" name="Um analista de uma equipe tecnica vai acessar o 1º chamado pendente da fila atribuida á sua especialidade e vai registrar a açao que tomou para tentar solucionar o caso e o sistema vai registrar um log com os dados de identificação do analista, ação realizada, data e hora da operação." id="id-9870ba3840574cdb89fb7b0a7cfdcbcd"/>
    <element xsi:type="archimate:Constraint" name="O analista de suporte que solucionou o problema de um chamado deve descrever o diagnostico e a solução aplicada. O sistema ira atualizar o status do chamado para fechado. Guardando no chamado o diagnostico e a solução. Alem disso, os sistema vai alimentar uma base de dados de soluções conhecidas com a descrição do problema, o diagnostico e a solução. A data e hora das operações sera guardada tambem em cada registro." id="id-bedd1c0c1d2f4125a2d364a44b317050"/>
    <element xsi:type="archimate:Requirement" name="Disparar pesquisa de satisfação" id="id-fd232776266145eb94e59af8e558ed74"/>
    <element xsi:type="archimate:Requirement" name="Coletar e guardar a resposta da pesquisa" id="id-4d1dc29206b74781ae68b106023adf7c"/>
    <element xsi:type="archimate:Constraint" name="A mensagem deve conter um texto padrao explicando o objetivo da pesquisa, identificar o protocolo e a descrição do problema original, acompanhando de uma lista de perguntas com opções de respostas pre-configurados(Lista de opções)" id="id-d8bc98e02dea4e1abeaadd5858ad3765"/>
    <element xsi:type="archimate:Constraint" name="Devem ser coletados as respostas e guardados os seguintes dados: identificação da pergunta e respostas escolhidas. Esses dados serão inseridos no banco de dados transcional do suporte para uso em consultas" id="id-5f6948b10543423ab27783ddf4c6a422"/>
    <element xsi:type="archimate:Requirement" name="Disponibilizar dados transacionais do suporte em um banco de dados data mart/dw" id="id-16b4c07d9bd64c8cbc3a3f11e892d146"/>
    <element xsi:type="archimate:Requirement" name="Construir uma aplicação ETL(Extração. transformação, e carga) para ler as bases de dados transacionais do suporte e alimentar um banco de dados de consulta(dw/datamart)" id="id-77d2e7d2b4194d91b45462354926f86d"/>
    <element xsi:type="archimate:Constraint" name="Construir uma aplicação ETL(Extração. transformação, e carga) para ler as bases de dados transacionais do suporte e alimentar um banco de dados de consulta(dw/datamart)" id="id-f3198295f91e44f58b05efd00cfd085e"/>
    <element xsi:type="archimate:Constraint" name="Deve ser informado pelo usuario a identificação do cliente, a descrição do problema. O sistema deve gerar um numero de protocolo de registro de chamada, com a data e hora de abertura e a identificação do analista de suporte que fez o contato, atribuind o status pendente. Somente clientes com contrato de suporte terão registro de chamado (copy)" id="id-d39aebe1e547494f8a85ac17b4f80a9b"/>
  </folder>
